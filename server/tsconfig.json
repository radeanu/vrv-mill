{
	"compilerOptions": {
		"incremental": true,
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"rootDir": "./",
		"paths": {
			"@/*": ["./src/*"]
		},
		"sourceMap": true,
		"verbatimModuleSyntax": true
	},
	"tsc-alias": {
		"verbose": false,
		"resolveFullPaths": true,
		"resolveFullExtension": true
	}
}
